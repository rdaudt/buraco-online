# Create an app in Cloudflare Dashboard → Realtime → Serverless SFU.
# Configure these as server-side secrets in Sites; never expose the app secret to browsers.
REALTIME_SFU_APP_ID=
REALTIME_SFU_APP_SECRET=

# Optional network relay for restrictive networks (Realtime → TURN).
REALTIME_TURN_KEY_ID=
REALTIME_TURN_API_TOKEN=
